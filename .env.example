# Compose substitutes these values at runtime. Keep real credentials in .env only.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=demo
MYSQL_USER=demo
MYSQL_PASSWORD=replace-with-a-strong-password

# Optional integrations.
WECHAT_WEBHOOK_URL=
GITEE_WEBHOOK_TOKEN=replace-with-a-random-token
HOOK_ENV=dev
HOOK_ENGINE=compose


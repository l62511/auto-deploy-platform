# Compose substitutes these values at runtime. Keep real credentials in .env only.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=demo
MYSQL_USER=demo
MYSQL_PASSWORD=replace-with-a-strong-password

# Optional integrations.
WECHAT_WEBHOOK_URL=
GITEE_WEBHOOK_TOKEN=replace-with-a-random-token
HOOK_ENV=dev
HOOK_ENGINE=compose
HOOK_APPROVAL_REQUIRED=0
# Maximum duration for one webhook-triggered pipeline, in seconds.
HOOK_PIPELINE_TIMEOUT=1800
# Production control-plane services. Use PostgreSQL and Redis in deployed environments.
PLATFORM_DATABASE_URL=postgresql+psycopg://deploy:replace-me@127.0.0.1:5432/auto_deploy
PLATFORM_REDIS_URL=redis://127.0.0.1:6379/0
PLATFORM_HEALTH_TOKEN=replace-with-a-separate-read-only-token
POSTGRES_PASSWORD=replace-with-a-strong-database-password
PLATFORM_TASK_STALE_SECONDS=3600
# Optional local JWT bootstrap for development only; prefer OIDC in production.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_LOCAL_ENABLED=0
AUTH_LOCAL_USERNAME=operator
AUTH_LOCAL_PASSWORD=replace-with-a-local-password
AUTH_LOCAL_ROLES=operator
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: Compose dev pipeline",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "args": [
        "--verbose",
        "pipeline",
        "--env",
        "dev",
        "--engine",
        "compose",
        "--version",
        "v1.0.0"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Gitee webhook server",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "args": [
        "webhook",
        "--port",
        "9000"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}

